# Voice service — copy to .env for local development.
# This service does not load .env automatically; export it into your shell:
#   set -a && . ./.env && set +a && npm run dev

PORT=3001
NODE_ENV=development
AWS_REGION=ap-northeast-1

# Server-side only — a browser WebSocket cannot set the api-subscription-key
# header Sarvam's realtime endpoint requires, so this never reaches the client.
SARVAM_API_KEY=

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

APP_TABLE_NAME=

# Comma-separated. A WebSocket upgrade never reaches CORS middleware, so this
# is checked explicitly on the upgrade.
ALLOWED_ORIGINS=http://localhost:3000
